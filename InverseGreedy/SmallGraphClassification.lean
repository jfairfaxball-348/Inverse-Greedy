theorem check5_all : allBool 10 check5 = true := by
  have h : allBool 10 check5 = (((allBool 7 (fun f => check5 (Fin.cons false (Fin.cons false (Fin.cons false f)))) && allBool 7 (fun f => check5 (Fin.cons false (Fin.cons false (Fin.cons true f))))) && (allBool 7 (fun f => check5 (Fin.cons false (Fin.cons true (Fin.cons false f)))) && allBool 7 (fun f => check5 (Fin.cons false (Fin.cons true (Fin.cons true f)))))) && ((allBool 7 (fun f => check5 (Fin.cons true (Fin.cons false (Fin.cons false f)))) && allBool 7 (fun f => check5 (Fin.cons true (Fin.cons false (Fin.cons true f))))) && (allBool 7 (fun f => check5 (Fin.cons true (Fin.cons true (Fin.cons false f)))) && allBool 7 (fun f => check5 (Fin.cons true (Fin.cons true (Fin.cons true f))))))) := rfl
  rw [h, check5_q000, check5_q001, check5_q010, check5_q011, check5_q100, check5_q101, check5_q110, check5_q111]
  rfl

