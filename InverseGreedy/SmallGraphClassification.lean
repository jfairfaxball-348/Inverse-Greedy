def check5 (f : Fin 10 → Bool) : Bool :=
  decide ((cert5.getD (code5 f) (0, id, id)).1 < 34) &&
    IsoCheckB rank5 f (repf5 (cert5.getD (code5 f) (0, id, id)).1)
      (cert5.getD (code5 f) (0, id, id)).2.1 (cert5.getD (code5 f) (0, id, id)).2.2


theorem check5_q000 : allBool 7 (fun f => check5 (Fin.cons false (Fin.cons false (Fin.cons false f)))) = true := by decide +kernel

