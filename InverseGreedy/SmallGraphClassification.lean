/-- **IG-P5 (Lean, genuine clocks), all graphs on five vertices.** -/
theorem fin5_realClockEGU_or_P5 (nb : Fin 5 → Finset (Fin 5))
    (hs : ∀ x y, y ∈ nb x → x ∈ nb y) (hi : ∀ v, v ∉ nb v) :
    RealClockEGU nb ∨ ∃ e : Fin 5 ≃ Fin 5, ∀ a, p5Nb (e a) = (nb a).map e.toEmbedding := by
  have hc := allBool_sound 10 check5 check5_all (fOf pair5 nb)
  rw [← nbOf_fOf rank5 pair5 hrank5 nb hs hi]
  simp only [check5, Bool.and_eq_true, decide_eq_true_eq] at hc
  rcases rep5_status _ hc.1 with h | h
  · exact Or.inl ((realClockEGU_iff_of_isoCheckB _ _ _ _ _ hc.2).mpr h)
  · right
    rw [← h]
    exact iso_of_isoCheckB _ _ _ _ _ hc.2

/-- **IG-P5 classification (Lean).** A graph on `Fin 5` is EGU iff it is
not isomorphic to P5. -/
theorem fin5_realClockEGU_iff_not_P5 (nb : Fin 5 → Finset (Fin 5))
    (hs : ∀ x y, y ∈ nb x → x ∈ nb y) (hi : ∀ v, v ∉ nb v) :
    RealClockEGU nb ↔ ¬ ∃ e : Fin 5 ≃ Fin 5, ∀ a, p5Nb (e a) = (nb a).map e.toEmbedding := by
  constructor
  · rintro h ⟨e, he⟩
    exact p5Nb_not_realClockEGU ((realClockEGU_congr_equiv e nb p5Nb he hs p5Nb_symm).mp h)
  · intro h
    rcases fin5_realClockEGU_or_P5 nb hs hi with h' | h'
    · exact h'
    · exact absurd h' h

/-- **IG-P5 (Lean, genuine clocks): all graphs on at most five vertices.**
Every symmetric irreflexive graph on `Fin n`, `n ≤ 5`, is EGU unless it is
isomorphic to P5 (which is not EGU). -/
theorem graphs_le_five_classification (n : ℕ) (hn : n ≤ 5) (nb : Fin n → Finset (Fin n))
    (hs : ∀ x y, y ∈ nb x → x ∈ nb y) (hi : ∀ v, v ∉ nb v) :
    RealClockEGU nb ∨ ∃ e : Fin n ≃ Fin 5, ∀ a, p5Nb (e a) = (nb a).map e.toEmbedding := by
  interval_cases n
  · exact Or.inl (fin0_all_realClockEGU nb hs)
  · exact Or.inl (fin1_all_realClockEGU nb hi)
  · exact Or.inl (fin2_all_realClockEGU nb hs hi)
  · exact Or.inl (fin3_all_realClockEGU nb hs hi)
  · exact Or.inl (fin4_all_realClockEGU nb hs hi)
  · exact fin5_realClockEGU_or_P5 nb hs hi

end InverseGreedy
