/-- NetworkX connected atlas n=6 index 66: S007 false-twin lift of complete S005 n=5 witness. -/
def atlas6_66 : Fin 6 → Finset (Fin 6) := ![{1, 2, 3, 4, 5}, {0, 2}, {0, 1, 3, 5}, {0, 2, 4}, {0, 3}, {0, 2}]

theorem atlas6_66_symm : ∀ x y, y ∈ atlas6_66 x → x ∈ atlas6_66 y := by decide

theorem atlas6_66_irrefl : ∀ v, v ∉ atlas6_66 v := by decide

theorem atlas6_66_egu : RealClockEGU atlas6_66 := by
  let e : Fin 6 ≃ Option (Fin 5) :=
    ⟨![some 1, some 0, some 4, some 3, some 2, none], fun x => x.elim (5 : Fin 6) ![1, 0, 4, 3, 2], by decide, by decide⟩
  have hnb : ∀ a, twinExtend atlas5_15 0 (e a) = (atlas6_66 a).map e.toEmbedding := by decide
  have hiso := realClockEGU_congr_equiv e atlas6_66 (twinExtend atlas5_15 0) hnb atlas6_66_symm
    (twinExtend_symm atlas5_15 atlas5_15_symm 0)
  have htw := realClockEGU_twinExtend_iff atlas5_15 atlas5_15_symm atlas5_15_irrefl 0
  exact hiso.mpr (htw.mpr atlas5_15_egu)

