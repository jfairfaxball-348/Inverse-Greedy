/-!
# S041: atlas certificates, part 13

GENERATED by `experiments/gen_atlas_lean.py` from the S009 census, but every
statement is checked by Lean: rational witnesses by kernel reduction
(`decide +kernel`, sound by `realClockEGU_of_ratWitness`), algebraic ones by
certified closed forms and `linear_combination`, negatives by relabelling to
the S041 obstruction theorems or a positive-coefficient minor certificate.
Graph names `atlas{n}_{i}` use NetworkX `graph_atlas_g()` connected-graph
indices and labellings. 90 theorems `RealClockEGU`, 8 theorems `¬ RealClockEGU`.
The 45 unresolved graphs receive no theorem (they are open).
The completeness of the NetworkX enumeration itself is NOT formalised.
-/

namespace InverseGreedy
/-- NetworkX connected atlas n=6 index 85: S007 false-twin lift of complete S005 n=5 witness. -/
def atlas6_85 : Fin 6 → Finset (Fin 6) := ![{2, 3, 5}, {2, 3}, {0, 1, 3, 4, 5}, {0, 1, 2, 4}, {2, 3, 5}, {0, 2, 4}]

theorem atlas6_85_symm : ∀ x y, y ∈ atlas6_85 x → x ∈ atlas6_85 y := by decide

theorem atlas6_85_irrefl : ∀ v, v ∉ atlas6_85 v := by decide

theorem atlas6_85_egu : RealClockEGU atlas6_85 := by
  let e : Fin 6 ≃ Option (Fin 5) :=
    ⟨![some 3, some 0, some 1, some 4, none, some 2], fun x => x.elim (4 : Fin 6) ![1, 2, 5, 0, 3], by decide, by decide⟩
  have hnb : ∀ a, twinExtend atlas5_15 3 (e a) = (atlas6_85 a).map e.toEmbedding := by decide
  have hiso := realClockEGU_congr_equiv e atlas6_85 (twinExtend atlas5_15 3) hnb atlas6_85_symm
    (twinExtend_symm atlas5_15 atlas5_15_symm 3)
  have htw := realClockEGU_twinExtend_iff atlas5_15 atlas5_15_symm atlas5_15_irrefl 3
  exact hiso.mpr (htw.mpr atlas5_15_egu)

