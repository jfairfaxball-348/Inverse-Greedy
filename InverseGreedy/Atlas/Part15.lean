/-- NetworkX connected atlas n=6 index 103: cograph join/union. -/
def atlas6_103 : Fin 6 → Finset (Fin 6) := ![{1, 2, 3, 4}, {0, 2, 3, 4}, {0, 1, 3, 4}, {0, 1, 2, 4, 5}, {0, 1, 2, 3, 5}, {3, 4}]

theorem atlas6_103_symm : ∀ x y, y ∈ atlas6_103 x → x ∈ atlas6_103 y := by decide

theorem atlas6_103_irrefl : ∀ v, v ∉ atlas6_103 v := by decide

theorem atlas6_103_egu : RealClockEGU atlas6_103 :=
  realClockEGU_of_ratWitness atlas6_103 ![3/4, 3/4, 3/4, 1, 1, 3/4] (by decide +kernel) atlas6_103_symm (by decide +kernel)

