namespace InverseGreedy
/-- NetworkX connected atlas n=6 index 50: exact rational rates. -/
def atlas6_50 : Fin 6 → Finset (Fin 6) := ![{1, 2, 4, 5}, {0, 2}, {0, 1, 3, 5}, {2, 4}, {0, 3}, {0, 2}]

theorem atlas6_50_symm : ∀ x y, y ∈ atlas6_50 x → x ∈ atlas6_50 y := by decide

theorem atlas6_50_irrefl : ∀ v, v ∉ atlas6_50 v := by decide

theorem atlas6_50_egu : RealClockEGU atlas6_50 :=
  realClockEGU_of_ratWitness atlas6_50 ![3, 4, 3, 2, 2, 1] (by decide +kernel) atlas6_50_symm (by decide +kernel)

