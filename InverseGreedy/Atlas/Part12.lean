/-- NetworkX connected atlas n=6 index 74: cograph join/union. -/
def atlas6_74 : Fin 6 → Finset (Fin 6) := ![{2, 4, 5}, {4, 5}, {0, 4, 5}, {4, 5}, {0, 1, 2, 3}, {0, 1, 2, 3}]

theorem atlas6_74_symm : ∀ x y, y ∈ atlas6_74 x → x ∈ atlas6_74 y := by decide

theorem atlas6_74_irrefl : ∀ v, v ∉ atlas6_74 v := by decide

theorem atlas6_74_egu : RealClockEGU atlas6_74 :=
  realClockEGU_of_ratWitness atlas6_74 ![1/2, 1/2, 1/2, 1/2, 1/2, 1/2] (by decide +kernel) atlas6_74_symm (by decide +kernel)

