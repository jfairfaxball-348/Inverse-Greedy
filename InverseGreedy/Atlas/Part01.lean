/-!
# S041: atlas certificates, part 1

GENERATED by `experiments/gen_atlas_lean.py` from the S009 census, but every
statement is checked by Lean: rational witnesses by kernel reduction
(`decide +kernel`, sound by `realClockEGU_of_ratWitness`), algebraic ones by
certified closed forms and `linear_combination`, negatives by relabelling to
the S041 obstruction theorems or a positive-coefficient minor certificate.
Graph names `atlas{n}_{i}` use NetworkX `graph_atlas_g()` connected-graph
indices and labellings. 90 theorems `RealClockEGU`, 8 theorems `¬ RealClockEGU`.
The 45 unresolved graphs receive no theorem (they are open).
The completeness of the NetworkX enumeration itself is NOT formalised.
-/

namespace InverseGreedy
/-- NetworkX connected atlas n=4 index 2: cograph join/union. -/
def atlas4_2 : Fin 4 → Finset (Fin 4) := ![{3}, {2, 3}, {1, 3}, {0, 1, 2}]

theorem atlas4_2_symm : ∀ x y, y ∈ atlas4_2 x → x ∈ atlas4_2 y := by decide

theorem atlas4_2_irrefl : ∀ v, v ∉ atlas4_2 v := by decide

theorem atlas4_2_egu : RealClockEGU atlas4_2 :=
  realClockEGU_of_ratWitness atlas4_2 ![2/3, 2/3, 2/3, 1] (by decide +kernel) atlas4_2_symm (by decide +kernel)

