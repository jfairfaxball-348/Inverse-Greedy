/-!
# S041: atlas certificates, part 16

GENERATED by `experiments/gen_atlas_lean.py` from the S009 census, but every
statement is checked by Lean: rational witnesses by kernel reduction
(`decide +kernel`, sound by `realClockEGU_of_ratWitness`), algebraic ones by
certified closed forms and `linear_combination`, negatives by relabelling to
the S041 obstruction theorems or a positive-coefficient minor certificate.
Graph names `atlas{n}_{i}` use NetworkX `graph_atlas_g()` connected-graph
indices and labellings. 90 theorems `RealClockEGU`, 8 theorems `¬ RealClockEGU`.
The 45 unresolved graphs receive no theorem (they are open).
The completeness of the NetworkX enumeration itself is NOT formalised.
-/

namespace InverseGreedy
/-- NetworkX connected atlas n=6 index 110: cograph join/union. -/
def atlas6_110 : Fin 6 → Finset (Fin 6) := ![{1, 2, 4, 5}, {0, 2, 3, 4, 5}, {0, 1, 3, 4, 5}, {1, 2, 4, 5}, {0, 1, 2, 3, 5}, {0, 1, 2, 3, 4}]

theorem atlas6_110_symm : ∀ x y, y ∈ atlas6_110 x → x ∈ atlas6_110 y := by decide

theorem atlas6_110_irrefl : ∀ v, v ∉ atlas6_110 v := by decide

theorem atlas6_110_egu : RealClockEGU atlas6_110 :=
  realClockEGU_of_ratWitness atlas6_110 ![1/2, 1, 1, 1/2, 1, 1] (by decide +kernel) atlas6_110_symm (by decide +kernel)

/-- NetworkX connected atlas n=6 index 111: cograph join/union. -/
def atlas6_111 : Fin 6 → Finset (Fin 6) := ![{1, 2, 3, 4, 5}, {0, 2, 3, 4, 5}, {0, 1, 3, 4, 5}, {0, 1, 2, 4, 5}, {0, 1, 2, 3, 5}, {0, 1, 2, 3, 4}]

theorem atlas6_111_symm : ∀ x y, y ∈ atlas6_111 x → x ∈ atlas6_111 y := by decide

theorem atlas6_111_irrefl : ∀ v, v ∉ atlas6_111 v := by decide

theorem atlas6_111_egu : RealClockEGU atlas6_111 :=
  realClockEGU_of_ratWitness atlas6_111 ![1, 1, 1, 1, 1, 1] (by decide +kernel) atlas6_111_symm (by decide +kernel)

end InverseGreedy
