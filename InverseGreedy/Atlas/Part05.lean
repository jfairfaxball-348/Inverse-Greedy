/-!
# S041: atlas certificates, part 5

GENERATED by `experiments/gen_atlas_lean.py` from the S009 census, but every
statement is checked by Lean: rational witnesses by kernel reduction
(`decide +kernel`, sound by `realClockEGU_of_ratWitness`), algebraic ones by
certified closed forms and `linear_combination`, negatives by relabelling to
the S041 obstruction theorems or a positive-coefficient minor certificate.
Graph names `atlas{n}_{i}` use NetworkX `graph_atlas_g()` connected-graph
indices and labellings. 90 theorems `RealClockEGU`, 8 theorems `¬ RealClockEGU`.
The 45 unresolved graphs receive no theorem (they are open).
The completeness of the NetworkX enumeration itself is NOT formalised.
-/

namespace InverseGreedy
/-- NetworkX connected atlas n=5 index 20: cograph join/union. -/
def atlas5_20 : Fin 5 → Finset (Fin 5) := ![{1, 2, 3, 4}, {0, 2, 3, 4}, {0, 1, 3, 4}, {0, 1, 2, 4}, {0, 1, 2, 3}]

theorem atlas5_20_symm : ∀ x y, y ∈ atlas5_20 x → x ∈ atlas5_20 y := by decide

theorem atlas5_20_irrefl : ∀ v, v ∉ atlas5_20 v := by decide

theorem atlas5_20_egu : RealClockEGU atlas5_20 :=
  realClockEGU_of_ratWitness atlas5_20 ![1, 1, 1, 1, 1] (by decide +kernel) atlas5_20_symm (by decide +kernel)

/-- NetworkX connected atlas n=6 index 0: cograph join/union. -/
def atlas6_0 : Fin 6 → Finset (Fin 6) := ![{5}, {5}, {5}, {5}, {5}, {0, 1, 2, 3, 4}]

theorem atlas6_0_symm : ∀ x y, y ∈ atlas6_0 x → x ∈ atlas6_0 y := by decide

theorem atlas6_0_irrefl : ∀ v, v ∉ atlas6_0 v := by decide

theorem atlas6_0_egu : RealClockEGU atlas6_0 :=
  realClockEGU_of_ratWitness atlas6_0 ![1/5, 1/5, 1/5, 1/5, 1/5, 1] (by decide +kernel) atlas6_0_symm (by decide +kernel)

/-- NetworkX connected atlas n=6 index 1: S006 exact positive rational witness. -/
def atlas6_1 : Fin 6 → Finset (Fin 6) := ![{1}, {0, 2, 4, 5}, {1, 3}, {2}, {1}, {1}]

theorem atlas6_1_symm : ∀ x y, y ∈ atlas6_1 x → x ∈ atlas6_1 y := by decide

theorem atlas6_1_irrefl : ∀ v, v ∉ atlas6_1 v := by decide

theorem atlas6_1_egu : RealClockEGU atlas6_1 :=
  realClockEGU_of_ratWitness atlas6_1 ![3, 6, 4, 5, 3, 3] (by decide +kernel) atlas6_1_symm (by decide +kernel)

/-- NetworkX connected atlas n=6 index 2: S007 false-twin lift of complete S005 n=5 witness. -/
def atlas6_2 : Fin 6 → Finset (Fin 6) := ![{1, 2, 3}, {0}, {0}, {0, 4, 5}, {3}, {3}]

theorem atlas6_2_symm : ∀ x y, y ∈ atlas6_2 x → x ∈ atlas6_2 y := by decide

theorem atlas6_2_irrefl : ∀ v, v ∉ atlas6_2 v := by decide

theorem atlas6_2_egu : RealClockEGU atlas6_2 :=
  realClockEGU_of_ratWitness atlas6_2 ![10, 7, 7, 9, 6, 6] (by decide +kernel) atlas6_2_symm (by decide +kernel)

/-- NetworkX connected atlas n=6 index 3: S009 strict corona(P3) probability minor. -/
def atlas6_3 : Fin 6 → Finset (Fin 6) := ![{1}, {0, 2, 3}, {1, 4}, {1, 5}, {2}, {3}]

theorem atlas6_3_symm : ∀ x y, y ∈ atlas6_3 x → x ∈ atlas6_3 y := by decide

theorem atlas6_3_irrefl : ∀ v, v ∉ atlas6_3 v := by decide

theorem atlas6_3_not_realClockEGU : ¬ RealClockEGU atlas6_3 := by
  let e : Fin 6 ≃ Fin 6 := ⟨![4, 1, 0, 2, 3, 5], ![2, 1, 3, 4, 0, 5], by decide, by decide⟩
  have hnb : ∀ a, coronaP3Nb (e a) = (atlas6_3 a).map e.toEmbedding := by decide
  exact fun h => coronaP3Nb_not_realClockEGU
    ((realClockEGU_congr_equiv e atlas6_3 coronaP3Nb hnb atlas6_3_symm coronaP3Nb_symm).mp h)

/-- NetworkX connected atlas n=6 index 4: S007 false-twin contraction to P5. -/
def atlas6_4 : Fin 6 → Finset (Fin 6) := ![{4, 5}, {3}, {3}, {1, 2, 4}, {0, 3}, {0}]

theorem atlas6_4_symm : ∀ x y, y ∈ atlas6_4 x → x ∈ atlas6_4 y := by decide

theorem atlas6_4_irrefl : ∀ v, v ∉ atlas6_4 v := by decide

theorem atlas6_4_not_realClockEGU : ¬ RealClockEGU atlas6_4 := by
  let e : Fin 6 ≃ Option (Fin 5) :=
    ⟨![some 3, some 0, none, some 1, some 2, some 4], fun x => x.elim (2 : Fin 6) ![1, 3, 4, 0, 5], by decide, by decide⟩
  have hnb : ∀ a, twinExtend p5Nb 0 (e a) = (atlas6_4 a).map e.toEmbedding := by decide
  have hiso := realClockEGU_congr_equiv e atlas6_4 (twinExtend p5Nb 0) hnb atlas6_4_symm
    (twinExtend_symm p5Nb p5Nb_symm 0)
  have htw := realClockEGU_twinExtend_iff p5Nb p5Nb_symm p5Nb_irrefl 0
  exact fun h => p5Nb_not_realClockEGU (htw.mp (hiso.mp h))

end InverseGreedy
