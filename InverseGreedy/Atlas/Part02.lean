/-!
# S041: atlas certificates, part 2

GENERATED by `experiments/gen_atlas_lean.py` from the S009 census, but every
statement is checked by Lean: rational witnesses by kernel reduction
(`decide +kernel`, sound by `realClockEGU_of_ratWitness`), algebraic ones by
certified closed forms and `linear_combination`, negatives by relabelling to
the S041 obstruction theorems or a positive-coefficient minor certificate.
Graph names `atlas{n}_{i}` use NetworkX `graph_atlas_g()` connected-graph
indices and labellings. 90 theorems `RealClockEGU`, 8 theorems `¬ RealClockEGU`.
The 45 unresolved graphs receive no theorem (they are open).
The completeness of the NetworkX enumeration itself is NOT formalised.
-/

namespace InverseGreedy
/-- NetworkX connected atlas n=5 index 2: P5 strict determinant. -/
def atlas5_2 : Fin 5 → Finset (Fin 5) := ![{1, 4}, {0, 2}, {1, 3}, {2}, {0}]

theorem atlas5_2_symm : ∀ x y, y ∈ atlas5_2 x → x ∈ atlas5_2 y := by decide

theorem atlas5_2_irrefl : ∀ v, v ∉ atlas5_2 v := by decide

theorem atlas5_2_not_realClockEGU : ¬ RealClockEGU atlas5_2 := by
  let e : Fin 5 ≃ Fin 5 := ⟨![3, 2, 1, 0, 4], ![3, 2, 1, 0, 4], by decide, by decide⟩
  have hnb : ∀ a, p5Nb (e a) = (atlas5_2 a).map e.toEmbedding := by decide
  exact fun h => p5Nb_not_realClockEGU
    ((realClockEGU_congr_equiv e atlas5_2 p5Nb hnb atlas5_2_symm p5Nb_symm).mp h)

/-- NetworkX connected atlas n=5 index 3: cograph join/union. -/
def atlas5_3 : Fin 5 → Finset (Fin 5) := ![{4}, {4}, {3, 4}, {2, 4}, {0, 1, 2, 3}]

theorem atlas5_3_symm : ∀ x y, y ∈ atlas5_3 x → x ∈ atlas5_3 y := by decide

theorem atlas5_3_irrefl : ∀ v, v ∉ atlas5_3 v := by decide

theorem atlas5_3_egu : RealClockEGU atlas5_3 :=
  realClockEGU_of_ratWitness atlas5_3 ![1/2, 1/2, 1/2, 1/2, 1] (by decide +kernel) atlas5_3_symm (by decide +kernel)

