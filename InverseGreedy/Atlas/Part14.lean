/-- NetworkX connected atlas n=6 index 101: S007 false-twin lift of complete S005 n=5 witness. -/
def atlas6_101 : Fin 6 → Finset (Fin 6) := ![{1, 2, 4, 5}, {0, 4, 5}, {0, 3, 4, 5}, {2, 4, 5}, {0, 1, 2, 3}, {0, 1, 2, 3}]

theorem atlas6_101_symm : ∀ x y, y ∈ atlas6_101 x → x ∈ atlas6_101 y := by decide

theorem atlas6_101_irrefl : ∀ v, v ∉ atlas6_101 v := by decide

theorem atlas6_101_egu : RealClockEGU atlas6_101 := by
  let e : Fin 6 ≃ Option (Fin 5) :=
    ⟨![some 4, some 0, some 3, some 2, some 1, none], fun x => x.elim (5 : Fin 6) ![1, 4, 3, 2, 0], by decide, by decide⟩
  have hnb : ∀ a, twinExtend atlas5_15 1 (e a) = (atlas6_101 a).map e.toEmbedding := by decide
  have hiso := realClockEGU_congr_equiv e atlas6_101 (twinExtend atlas5_15 1) hnb atlas6_101_symm
    (twinExtend_symm atlas5_15 atlas5_15_symm 1)
  have htw := realClockEGU_twinExtend_iff atlas5_15 atlas5_15_symm atlas5_15_irrefl 1
  exact hiso.mpr (htw.mpr atlas5_15_egu)

