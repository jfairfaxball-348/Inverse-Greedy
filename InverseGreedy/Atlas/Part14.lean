/-- NetworkX connected atlas n=6 index 95: cograph join/union. -/
def atlas6_95 : Fin 6 → Finset (Fin 6) := ![{1, 2, 3}, {0, 2, 3, 4, 5}, {0, 1, 3, 4, 5}, {0, 1, 2, 5}, {1, 2}, {1, 2, 3}]

theorem atlas6_95_symm : ∀ x y, y ∈ atlas6_95 x → x ∈ atlas6_95 y := by decide

theorem atlas6_95_irrefl : ∀ v, v ∉ atlas6_95 v := by decide

theorem atlas6_95_egu : RealClockEGU atlas6_95 :=
  realClockEGU_of_ratWitness atlas6_95 ![1/3, 1, 1, 2/3, 2/3, 1/3] (by decide +kernel) atlas6_95_symm (by decide +kernel)

