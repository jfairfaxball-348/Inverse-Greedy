/-- NetworkX connected atlas n=6 index 8: S008 exact cubic algebraic clique-corona family. -/
def atlas6_8 : Fin 6 → Finset (Fin 6) := ![{4}, {5}, {3}, {2, 4, 5}, {0, 3, 5}, {1, 3, 4}]

theorem atlas6_8_symm : ∀ x y, y ∈ atlas6_8 x → x ∈ atlas6_8 y := by decide

theorem atlas6_8_irrefl : ∀ v, v ∉ atlas6_8 v := by decide

theorem atlas6_8_egu : RealClockEGU atlas6_8 := by
  let e : Fin 6 ≃ Fin 3 ⊕ Fin 3 :=
    ⟨![(Sum.inl 0 : Fin 3 ⊕ Fin 3), (Sum.inl 1 : Fin 3 ⊕ Fin 3), (Sum.inl 2 : Fin 3 ⊕ Fin 3), (Sum.inr 2 : Fin 3 ⊕ Fin 3), (Sum.inr 0 : Fin 3 ⊕ Fin 3), (Sum.inr 1 : Fin 3 ⊕ Fin 3)], fun x => Sum.elim ![0, 1, 2] ![4, 5, 3] x, by decide, by decide⟩
  have hnb : ∀ a, cliqueCoronaNb 3 (e a) = (atlas6_8 a).map e.toEmbedding := by decide
  exact (realClockEGU_congr_equiv e atlas6_8 (cliqueCoronaNb 3) hnb atlas6_8_symm
    (cliqueCoronaNb_symm 3)).mpr (cliqueCorona_realClockEGU 3 (by norm_num))

/-- NetworkX connected atlas n=6 index 10: S007 false-twin lift of complete S005 n=5 witness. -/
def atlas6_10 : Fin 6 → Finset (Fin 6) := ![{2, 3, 4, 5}, {2, 3}, {0, 1}, {0, 1}, {0}, {0}]

theorem atlas6_10_symm : ∀ x y, y ∈ atlas6_10 x → x ∈ atlas6_10 y := by decide

theorem atlas6_10_irrefl : ∀ v, v ∉ atlas6_10 v := by decide

theorem atlas6_10_egu : RealClockEGU atlas6_10 :=
