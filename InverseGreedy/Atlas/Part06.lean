/-- NetworkX connected atlas n=6 index 13: S007 false-twin contraction to P5. -/
def atlas6_13 : Fin 6 → Finset (Fin 6) := ![{2}, {3}, {0, 4, 5}, {1, 4, 5}, {2, 3}, {2, 3}]

theorem atlas6_13_symm : ∀ x y, y ∈ atlas6_13 x → x ∈ atlas6_13 y := by decide

theorem atlas6_13_irrefl : ∀ v, v ∉ atlas6_13 v := by decide

theorem atlas6_13_not_realClockEGU : ¬ RealClockEGU atlas6_13 := by
  let e : Fin 6 ≃ Option (Fin 5) :=
    ⟨![some 0, some 4, some 1, some 3, some 2, none], fun x => x.elim (5 : Fin 6) ![0, 2, 4, 3, 1], by decide, by decide⟩
  have hnb : ∀ a, twinExtend p5Nb 2 (e a) = (atlas6_13 a).map e.toEmbedding := by decide
  have hiso := realClockEGU_congr_equiv e atlas6_13 (twinExtend p5Nb 2) hnb atlas6_13_symm
    (twinExtend_symm p5Nb p5Nb_symm 2)
  have htw := realClockEGU_twinExtend_iff p5Nb p5Nb_symm p5Nb_irrefl 2
  exact fun h => p5Nb_not_realClockEGU (htw.mp (hiso.mp h))

end InverseGreedy
