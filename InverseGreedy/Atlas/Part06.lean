/-!
# S041: atlas certificates, part 6

GENERATED by `experiments/gen_atlas_lean.py` from the S009 census, but every
statement is checked by Lean: rational witnesses by kernel reduction
(`decide +kernel`, sound by `realClockEGU_of_ratWitness`), algebraic ones by
certified closed forms and `linear_combination`, negatives by relabelling to
the S041 obstruction theorems or a positive-coefficient minor certificate.
Graph names `atlas{n}_{i}` use NetworkX `graph_atlas_g()` connected-graph
indices and labellings. 90 theorems `RealClockEGU`, 8 theorems `¬ RealClockEGU`.
The 45 unresolved graphs receive no theorem (they are open).
The completeness of the NetworkX enumeration itself is NOT formalised.
-/

namespace InverseGreedy
/-- NetworkX connected atlas n=6 index 5: P6 double-triple race bottleneck. -/
def atlas6_5 : Fin 6 → Finset (Fin 6) := ![{1, 5}, {0}, {3}, {2, 4}, {3, 5}, {0, 4}]

theorem atlas6_5_symm : ∀ x y, y ∈ atlas6_5 x → x ∈ atlas6_5 y := by decide

theorem atlas6_5_irrefl : ∀ v, v ∉ atlas6_5 v := by decide

theorem atlas6_5_not_realClockEGU : ¬ RealClockEGU atlas6_5 := by
  let e : Fin 6 ≃ Fin 6 := ⟨![1, 0, 5, 4, 3, 2], ![1, 0, 5, 4, 3, 2], by decide, by decide⟩
  have hnb : ∀ a, p6Nb (e a) = (atlas6_5 a).map e.toEmbedding := by decide
  exact fun h => p6Nb_not_realClockEGU
    ((realClockEGU_congr_equiv e atlas6_5 p6Nb hnb atlas6_5_symm p6Nb_symm).mp h)

/-- NetworkX connected atlas n=6 index 6: cograph join/union. -/
def atlas6_6 : Fin 6 → Finset (Fin 6) := ![{5}, {5}, {5}, {4, 5}, {3, 5}, {0, 1, 2, 3, 4}]

theorem atlas6_6_symm : ∀ x y, y ∈ atlas6_6 x → x ∈ atlas6_6 y := by decide

theorem atlas6_6_irrefl : ∀ v, v ∉ atlas6_6 v := by decide

theorem atlas6_6_egu : RealClockEGU atlas6_6 :=
  realClockEGU_of_ratWitness atlas6_6 ![2/5, 2/5, 2/5, 2/5, 2/5, 1] (by decide +kernel) atlas6_6_symm (by decide +kernel)

/-- NetworkX connected atlas n=6 index 7: S007 false-twin lift of complete S005 n=5 witness. -/
def atlas6_7 : Fin 6 → Finset (Fin 6) := ![{3, 4}, {4}, {4}, {0, 4, 5}, {0, 1, 2, 3}, {3}]

theorem atlas6_7_symm : ∀ x y, y ∈ atlas6_7 x → x ∈ atlas6_7 y := by decide

theorem atlas6_7_irrefl : ∀ v, v ∉ atlas6_7 v := by decide

theorem atlas6_7_egu : RealClockEGU atlas6_7 :=
