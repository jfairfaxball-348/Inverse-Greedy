  have h2 := hr 2
  have h3 := hr 3
  have h4 := hr 4
  have h5 := hr 5
  rw [p6Nb_law_025 r hr, p6Nb_law_035 r hr]
  have key : (1 - r 1 / (r 0 + r 1 + r 2)) * (1 - r 4 / (r 3 + r 4 + r 5)) -
      (r 2*r 5*(r 0 + r 2 + r 3)/((r 2 + r 3)*(r 4 + r 5)*(r 0 + r 1 + r 2 + r 3))) - (r 0*r 3*(r 2 + r 3 + r 5)/((r 0 + r 1)*(r 2 + r 3)*(r 2 + r 3 + r 4 + r 5))) =
      (r 2*r 3*((r 0)^3*r 4 + 2*(r 0)^2*r 1*r 4 + 2*(r 0)^2*r 2*r 4 + (r 0)^2*r 3*r 4 + r 0*(r 1)^2*r 4 + 3*r 0*r 1*r 2*r 4 + 2*r 0*r 1*r 3*r 4 + r 0*r 1*(r 4)^2 + r 0*r 1*r 4*r 5 + r 0*(r 2)^2*r 4 + r 0*r 2*r 3*r 4 + (r 1)^2*r 2*r 4 + (r 1)^2*r 3*r 4 + (r 1)^2*(r 4)^2 + (r 1)^2*r 4*r 5 + r 1*(r 2)^2*r 4 + 2*r 1*r 2*r 3*r 4 + r 1*r 2*r 3*r 5 + r 1*r 2*(r 4)^2 + 2*r 1*r 2*r 4*r 5 + r 1*r 2*(r 5)^2 + r 1*(r 3)^2*r 4 + r 1*(r 3)^2*r 5 + r 1*r 3*(r 4)^2 + 3*r 1*r 3*r 4*r 5 + 2*r 1*r 3*(r 5)^2 + r 1*(r 4)^2*r 5 + 2*r 1*r 4*(r 5)^2 + r 1*(r 5)^3)) / ((r 0 + r 1)*(r 4 + r 5)*(r 0 + r 1 + r 2)*(r 3 + r 4 + r 5)*(r 0 + r 1 + r 2 + r 3)*(r 2 + r 3 + r 4 + r 5)) := by
    field_simp
    ring
  have hpos : 0 < (r 2*r 3*((r 0)^3*r 4 + 2*(r 0)^2*r 1*r 4 + 2*(r 0)^2*r 2*r 4 + (r 0)^2*r 3*r 4 + r 0*(r 1)^2*r 4 + 3*r 0*r 1*r 2*r 4 + 2*r 0*r 1*r 3*r 4 + r 0*r 1*(r 4)^2 + r 0*r 1*r 4*r 5 + r 0*(r 2)^2*r 4 + r 0*r 2*r 3*r 4 + (r 1)^2*r 2*r 4 + (r 1)^2*r 3*r 4 + (r 1)^2*(r 4)^2 + (r 1)^2*r 4*r 5 + r 1*(r 2)^2*r 4 + 2*r 1*r 2*r 3*r 4 + r 1*r 2*r 3*r 5 + r 1*r 2*(r 4)^2 + 2*r 1*r 2*r 4*r 5 + r 1*r 2*(r 5)^2 + r 1*(r 3)^2*r 4 + r 1*(r 3)^2*r 5 + r 1*r 3*(r 4)^2 + 3*r 1*r 3*r 4*r 5 + 2*r 1*r 3*(r 5)^2 + r 1*(r 4)^2*r 5 + 2*r 1*r 4*(r 5)^2 + r 1*(r 5)^3)) / ((r 0 + r 1)*(r 4 + r 5)*(r 0 + r 1 + r 2)*(r 3 + r 4 + r 5)*(r 0 + r 1 + r 2 + r 3)*(r 2 + r 3 + r 4 + r 5)) := by positivity
