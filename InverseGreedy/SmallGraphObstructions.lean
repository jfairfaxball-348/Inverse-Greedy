  have h3 := hr 3
  have h4 := hr 4
  rw [p5Nb_law_03 r hr, p5Nb_law_14 r hr, p5Nb_law_024 r hr, p5Nb_law_13 r hr]
  have key : (((r 0)^2*r 2 + (r 0)^2*r 4 + r 0*r 1*r 2 + r 0*r 1*r 4 + 2*r 0*(r 2)^2 + r 0*r 2*r 3 + 3*r 0*r 2*r 4 + r 0*r 3*r 4 + r 0*(r 4)^2 + r 1*(r 2)^2 + r 1*r 2*r 3 + r 1*r 2*r 4 + (r 2)^3 + (r 2)^2*r 3 + 2*(r 2)^2*r 4 + r 2*r 3*r 4 + r 2*(r 4)^2)/((r 0 + r 1 + r 2)*(r 2 + r 3 + r 4)*(r 0 + r 1 + r 2 + r 3 + r 4))) * (r 1*r 3*(r 0 + r 1 + r 3 + r 4)/((r 0 + r 1)*(r 3 + r 4)*(r 0 + r 1 + r 2 + r 3 + r 4))) - (r 0*r 3/((r 0 + r 1)*(r 2 + r 3 + r 4))) * (r 1*r 4/((r 3 + r 4)*(r 0 + r 1 + r 2))) =
