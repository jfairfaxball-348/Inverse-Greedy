  have hpos : 0 < (r 1*r 2*r 3*((r 0)^3 + 2*(r 0)^2*r 1 + 2*(r 0)^2*r 2 + 2*(r 0)^2*r 3 + 2*(r 0)^2*r 4 + r 0*(r 1)^2 + 3*r 0*r 1*r 2 + 3*r 0*r 1*r 3 + 3*r 0*r 1*r 4 + r 0*(r 2)^2 + 3*r 0*r 2*r 3 + 3*r 0*r 2*r 4 + r 0*(r 3)^2 + 3*r 0*r 3*r 4 + 2*r 0*(r 4)^2 + (r 1)^2*r 2 + (r 1)^2*r 3 + (r 1)^2*r 4 + r 1*(r 2)^2 + 2*r 1*r 2*r 3 + 3*r 1*r 2*r 4 + r 1*(r 3)^2 + 3*r 1*r 3*r 4 + 2*r 1*(r 4)^2 + (r 2)^2*r 3 + (r 2)^2*r 4 + r 2*(r 3)^2 + 3*r 2*r 3*r 4 + 2*r 2*(r 4)^2 + (r 3)^2*r 4 + 2*r 3*(r 4)^2 + (r 4)^3)) / ((r 0 + r 1)*(r 3 + r 4)*(r 0 + r 1 + r 2)*(r 2 + r 3 + r 4)*(r 0 + r 1 + r 2 + r 3 + r 4)^2) := by positivity
